{
  "name": "vellore-fitness-service-management",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "postinstall": "node scripts/db-command.mjs generate",
    "prebuild": "npm run db:generate",
    "build": "next build",
    "build:full": "npm run db:generate && next build",
    "start": "next start",
    "db:generate": "node scripts/db-command.mjs generate",
    "db:migrate": "node scripts/db-command.mjs migrate dev",
    "db:deploy": "node scripts/db-command.mjs migrate deploy",
    "db:push": "node scripts/db-command.mjs db push",
    "db:seed": "node scripts/db-command.mjs seed",
    "db:studio": "node scripts/db-command.mjs studio",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:core": "node scripts/verify-core.mjs",
    "test:core:run": "node scripts/run-core-validation.mjs",
    "test:live-smoke": "node scripts/verify-live-smoke.mjs",
    "test:live-smoke:run": "node scripts/run-live-smoke.mjs",
    "test:migrations": "node scripts/verify-migrations.mjs",
    "test:bill-machines": "node --import tsx scripts/verify-bill-machines.ts",
    "db:local:start": "powershell -ExecutionPolicy Bypass -File scripts/local-postgres.ps1 start",
    "db:local:stop": "powershell -ExecutionPolicy Bypass -File scripts/local-postgres.ps1 stop",
    "db:local:status": "powershell -ExecutionPolicy Bypass -File scripts/local-postgres.ps1 status",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@react-pdf/renderer": "^4.3.0",
    "bcryptjs": "^2.4.3",
    "countrycitystatejson": "^26.9.2802",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "next": "15.5.28",
    "next-auth": "^4.24.11",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "engines": {
    "node": "22.x || 24.x"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.1.0",
    "postcss": "8.5.30",
    "prisma": "^6.19.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "postcss": "8.5.30",
    "source-map-js": "1.2.2"
  }
}
