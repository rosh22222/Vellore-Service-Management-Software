# Supabase PostgreSQL or any PostgreSQL URL.
# For Supabase pooled connection, use the pooler URL recommended by Supabase.
DATABASE_URL="postgresql://postgres:password@localhost:5432/vfe_service?schema=public"
# Limit each application instance so pooled PostgreSQL connections stay stable.
DATABASE_CONNECTION_LIMIT="3"

# Generate a strong value before deployment, e.g. openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
